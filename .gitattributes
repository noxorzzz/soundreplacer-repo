# Нормализация переводов строк и diff-режимы для GitHub.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.md        text
*.json      text
*.yml       text
*.yaml      text
*.ps1       text
*.gitignore text

*.dll       binary
*.exe       binary
*.pdb       binary
*.png       binary
*.jpg       binary
*.ogg       binary
*.wav       binary